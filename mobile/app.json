{
  "expo": {
    "name": "AIBodyScan",
    "slug": "aibodyscan",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "aibodyscan",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f172a"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.aibodyscan.app",
      "infoPlist": {
        "NSCameraUsageDescription": "AIBodyScan needs camera access to scan your body measurements",
        "NSPhotoLibraryUsageDescription": "AIBodyScan needs photo library access to select wardrobe photos"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0f172a"
      },
      "package": "com.aibodyscan.app",
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow AIBodyScan to access your camera for body scanning"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow AIBodyScan to access your photos for wardrobe"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "your-eas-project-id"
      }
    }
  }
}