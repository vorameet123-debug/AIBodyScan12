# ============================================================
# AIBodyScan API — Environment Variables Template
# ============================================================
# Copy this file to .env and fill in your actual values:
#   cp .env.example .env
#
# NEVER commit .env with real keys!
# ============================================================

# --- AI Services ---
# Replicate: https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=r8_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Groq: https://console.groq.com/keys
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Payment Gateway ---
# Razorpay: https://dashboard.razorpay.com/app/keys
# Use test keys for development, live keys for production
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret_here

# --- Authentication ---
# Generate a secure secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=generate_a_random_64_char_hex_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- WhatsApp Business API (Optional) ---
# Meta Developer: https://developers.facebook.com/
WHATSAPP_ACCESS_TOKEN=EAAxxxxxxxxxxxxxxxxx
WHATSAPP_PHONE_NUMBER_ID=000000000000000
WHATSAPP_BUSINESS_ACCOUNT_ID=000000000000000

# --- Deployment ---
# Set to "production" in production environments
ENVIRONMENT=development

# Comma-separated allowed CORS origins
# REQUIRED in production (will raise error if missing)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# --- Error Tracking (Optional) ---
# Sentry: https://sentry.io/
# SENTRY_DSN=https://xxxxx@sentry.io/xxxxx

# --- Email (SMTP) ---
# Used for forgot-password and email verification flows
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-app-email@gmail.com
SMTP_PASSWORD=your_16_char_app_password
FROM_EMAIL=your-app-email@gmail.com
APP_URL=http://localhost:3000

# --- Google OAuth (Optional) ---
GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com
